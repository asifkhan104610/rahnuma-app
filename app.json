{
  "expo": {
    "name": "Rahnuma",
    "slug": "educationinkarachi-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "educationinkarachiapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#fdf6e3",
        "foregroundImage": "./assets/images/icon.png"
      },
      "package": "com.educationinkarachi.app",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "onesignal-expo-plugin",
        {
          "mode": "production",
          "disableLocation": true
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#061A36",
          "android": {
            "image": "./assets/images/splash-icon.png",
"imageWidth": 220
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "50dc9649-5218-4301-b041-a4b37f78f5df"
      }
    }
  }
}